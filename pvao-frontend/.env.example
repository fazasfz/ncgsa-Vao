# NASA API Key (get one at https://api.nasa.gov)
VITE_NASA_API_KEY=DEMO_KEY

# Optional: override the same-origin serverless AstroCopilot endpoint.
# Never put a Gemini key in a VITE_* variable.
# VITE_ASTROCOPILOT_API_URL=/api/astrocopilot

# Server-side only. Set this in Vercel Environment Variables or local .env.local.
GEMINI_API_KEY=
